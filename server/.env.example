# Copy this file to server/.env and replace the placeholders.
# Neon connection string (use the pooled or direct URL; Prisma migrations prefer the direct URL).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# API
NODE_ENV="development"
PORT="4000"
LOG_LEVEL="info"

# Allowed browser origin(s), comma-separated. Vite dev server uses port 5173.
CLIENT_ORIGIN="http://localhost:5173"

# Admin sessions: use a random secret of at least 32 characters in production.
JWT_SECRET="replace-with-a-random-32-plus-character-secret"
JWT_EXPIRES_IN="30m"
SESSION_COOKIE_NAME="eventmatch_admin"
CSRF_COOKIE_NAME="eventmatch_csrf"

# Seed admin (SEED_ADMIN_PASSWORD is required in production and must be 12+ chars).
SEED_ADMIN_NAME="EventHub Admin"
SEED_ADMIN_EMAIL="admin@eventhub.dev"
SEED_ADMIN_PASSWORD="replace-with-a-strong-development-password"

# Rate limiting (requests per window unless noted)
GENERAL_RATE_LIMIT_MAX="600"
GENERAL_RATE_LIMIT_WINDOW_MS="900000"
LOGIN_RATE_LIMIT_MAX="10"
LOGIN_RATE_LIMIT_WINDOW_MS="900000"
RECOMMENDATION_RATE_LIMIT_MAX="60"
RECOMMENDATION_RATE_LIMIT_WINDOW_MS="900000"
